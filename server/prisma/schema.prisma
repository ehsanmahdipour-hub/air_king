// Prisma schema for the air combat game.
// Phase 1 defined a diagnostics table used to verify database connectivity.
// Phase 2 adds authentication models (User, RefreshToken).
// Phase 7 adds player progression (PlayerProfile, LevelProgress).
// Phase 8 adds upgrades (PlayerUpgrade).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  username      String          @unique
  passwordHash  String
  role          String          @default("player")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  refreshTokens RefreshToken[]
  profile       PlayerProfile?
  levelProgress LevelProgress[]
  upgrades      PlayerUpgrade[]
  aircraft      PlayerAircraft[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One progression row per user. Coins, scores, the current level and the
/// equipped aircraft are owned by the server and only changed through validated
/// progression events.
model PlayerProfile {
  userId             String   @id
  coins              Int      @default(0)
  totalScore         Int      @default(0)
  highestScore       Int      @default(0)
  currentLevelId     String   @default("level-01")
  equippedAircraftId String   @default("starter")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per aircraft a player has purchased. The default aircraft is owned
/// implicitly and does not need a row.
model PlayerAircraft {
  id         String   @id @default(cuid())
  userId     String
  aircraftId String
  acquiredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, aircraftId])
  @@index([userId])
}

model LevelProgress {
  id          String    @id @default(cuid())
  userId      String
  levelId     String
  completed   Boolean   @default(false)
  bestScore   Int       @default(0)
  attempts    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId])
}

/// One row per purchased upgrade level. Costs and values come from the shared
/// upgrade config; the server owns the level and the coin deduction.
model PlayerUpgrade {
  id        String   @id @default(cuid())
  userId    String
  upgradeId String
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, upgradeId])
  @@index([userId])
}