# Environment configuration for the game server.
# Copy to `.env` and adjust values for your environment.

# Database connection string. SQLite for local development, PostgreSQL in production.
DATABASE_URL="file:./dev.db"

# HTTP server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Authentication secrets.
# JWT_SECRET must be at least 32 characters. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-secret-at-least-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
